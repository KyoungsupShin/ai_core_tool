# Same variable names as KyoungsupShin/devday2026.
# Fill in your own service key locally. No OpenAI API key is required.
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_RESOURCE_GROUP=default

# A tool-calling model available in your Gen AI Hub resource group.
LLM_MODEL=
LLM_SEED=20261018
# Optional: select a specific deployment for LLM_MODEL.
AICORE_LLM_DEPLOYMENT_ID=
