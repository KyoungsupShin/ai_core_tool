[
  {
    "type": "function",
    "function": {
      "name": "list_models",
      "description": "List SAP AI Core pricing models and original version names. Default mode: external.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mode": {
            "enum": [
              "external",
              "internal"
            ]
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_model_pricing",
      "description": "Return version-specific raw token prices, supported pricing modes and required usage fields. Token prices are per 1000 tokens before the CU multiplier.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "modelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mode": {
            "enum": [
              "external",
              "internal"
            ]
          }
        },
        "required": [
          "modelId",
          "version"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_compute_instances",
      "description": "List compute instance keys and CU per hour, including SAP resource plans.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mode": {
            "enum": [
              "external",
              "internal"
            ]
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "estimate_ai_core_cost",
      "description": "Estimate monthly SAP AI Core CU from an explicit configuration. Token fields are per request; requests are monthly. Optional services are disabled unless enabled explicitly. Returns exact decimal strings, line items and pricing/rule versions. External currency requires a contract ratePerCU.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "external",
              "internal"
            ]
          },
          "foundationModels": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "modelId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "pricingMode": {
                  "enum": [
                    "Standard",
                    "Cached",
                    "Batch"
                  ]
                },
                "cacheDuration": {
                  "enum": [
                    "5min",
                    "1h"
                  ]
                },
                "searchEffort": {
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "usage": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "inputTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "outputTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "requestsPerMonth": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "readCachedInputTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "writeCachedInputTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "inputTextTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "outputTextTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "inputAudioTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "outputAudioTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "cachedAudioTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "inputImageTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "outputImageTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "inputVideoTokensPerRequest": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "queriesPerMonth": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "contextCellsPerPrediction": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "predictedCellsPerPrediction": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "predictionsPerMonth": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": []
                }
              },
              "required": [
                "modelId",
                "version",
                "pricingMode",
                "usage"
              ]
            }
          },
          "orchestration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "contentFilter": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "blocksPerMonth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "grounding": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "queriesPerMonth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "storageGBDay": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "translation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "requestsPerMonth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "dataMasking": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "requestsPerMonth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "inferenceObservability": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "requestsPerMonth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "enabled"
            ]
          },
          "promptOptimization": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "promptsPerMonth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "enabled"
            ]
          },
          "evaluation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "nodeHoursPerMonth": {
                "type": "number",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "enabled"
            ]
          },
          "compute": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "instances": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "instanceKey": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "hoursPerMonth": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "replicas": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000
                    },
                    "storageGB": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "instanceKey",
                    "hoursPerMonth",
                    "replicas"
                  ]
                }
              },
              "objectStorage": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "storageGB": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "enabled"
            ]
          },
          "currency": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "ratePerCU": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000
              }
            },
            "required": [
              "code",
              "ratePerCU"
            ]
          }
        },
        "required": []
      }
    }
  }
]
